// NaturoFiche — schéma complet (mono-utilisateur).
// DB de prod = MySQL/MariaDB (cPanel WHC), accédée via le driver adapter pur-JS
// `@prisma/adapter-mariadb` (pas de moteur Rust, contourne CageFS). Voir tasks/DEPLOY.md.
// MySQL n'a pas d'enums utilisés ici : les listes restent du String JSON (colonnes TEXT),
// les "enums" restent des String documentés (voir commentaires). Champs longs => @db.Text
// (sinon MySQL mappe String -> varchar(191) et tronque le texte verbatim / le markdown / le JSON).

generator client {
  provider      = "prisma-client-js"
  // Driver adapters (GA depuis Prisma 6) : la connexion DB est faite par l'adapter
  // pur-JS @prisma/adapter-mariadb (réseau MySQL, jamais d'I/O fichier) ; le moteur Rust
  // ne fait que la planification. Sur WHC/CageFS le binaire moteur s'exécute (vérifié),
  // seul l'accès fichier SQLite était bloqué — d'où le passage à MySQL. Voir tasks/DEPLOY.md.
  // Cible debian-openssl-1.1.x = runtime détecté par Prisma sur l'hôte WHC (CloudLinux el8).
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Un cours importé (le PDF du cours + le PDF de l'examen) et son parcours.
/// Mono-cours actif à la fois, mais on garde l'historique.
model Course {
  id              String   @id @default(cuid())
  title           String
  code            String?
  delaiJours      Int
  dateDebut       DateTime @default(now())
  // statut : nouveau | extraction | ingestion | verification | pret | erreur
  statut          String   @default("nouveau")
  // Progression de l'ingestion IA (M2) : label d'étape + % pour la barre de progression.
  etapeIngestion  String?
  progressPct     Int      @default(0)
  erreurMessage   String?  @db.Text
  cheminPdfCours  String
  // Optionnel : certains cours incluent l'examen dans le PDF du cours (pas de fichier séparé).
  cheminPdfExamen String?
  ingestModel     String?
  actif           Boolean  @default(true) // un seul cours "actif" affiché en home
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections    Section[]
  studyUnits  StudyUnit[]
  questions   Question[]
  qaMessages  QaMessage[]
  officialKey OfficialKey?
  apiLogs     ApiUsageLog[]
}

/// Une section logique du cours, issue du découpage (structurel en M1, IA en M2).
model Section {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titre      String  @db.Text
  niveau     Int     // profondeur de titre (1 = chapitre, 2 = sous-section…)
  ordre      Int     // ordre d'apparition dans le document
  texte      String  @db.LongText
  // type : notion | tableau | diathese | meta
  type       String  @default("notion")
  // importance : essentiel | utile | secondaire (renseigné en M2)
  importance String?

  questions Question[]

  @@index([courseId, ordre])
}

/// Unité d'étude = une "fiche du jour". Regroupe une ou plusieurs sections.
model StudyUnit {
  id            String  @id @default(cuid())
  courseId      String
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ordre         Int
  jourCible     Int
  titre         String  @db.Text
  sectionsLiees String  @default("[]") @db.Text // JSON: string[] d'ids de Section

  fiche    Fiche?
  progress Progress?
  qaMessages QaMessage[]

  @@index([courseId, ordre])
}

/// La fiche de synthèse rattachée à une unité d'étude.
model Fiche {
  id              String    @id @default(cuid())
  studyUnitId     String    @unique
  studyUnit       StudyUnit @relation(fields: [studyUnitId], references: [id], onDelete: Cascade)
  contenuMarkdown String    @db.LongText
  notionsCles     String    @default("[]") @db.Text // JSON: string[]
}

/// Une question (quiz de vérif, examen blanc, ou examen officiel).
model Question {
  id               String   @id @default(cuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // type : quiz_verif | examen_blanc | examen_officiel
  type             String
  enonce           String   @db.Text
  options          String   @db.Text // JSON: { key: "A"|"B"|"C"|"D", text: string }[]
  bonneReponse     String?  // "A" | "B" | "C" | "D" (déduite par l'IA en M2)
  justification    String?  @db.Text
  sectionSourceId  String?
  sectionSource    Section? @relation(fields: [sectionSourceId], references: [id], onDelete: SetNull)
  // statutValidation : en_attente | valide | rejete
  statutValidation String   @default("en_attente")
  studyUnitId      String?  // pour un quiz_verif rattaché à une unité

  reviewItem ReviewItem?

  @@index([courseId, type])
}

/// Progression d'une unité d'étude (complétion + score du mini-quiz).
model Progress {
  id          String    @id @default(cuid())
  studyUnitId String    @unique
  studyUnit   StudyUnit @relation(fields: [studyUnitId], references: [id], onDelete: Cascade)
  completeLe  DateTime?
  scoreQuiz   Int?
}

/// Répétition espacée — boîtes de Leitner (M4).
model ReviewItem {
  id                String    @id @default(cuid())
  questionId        String    @unique
  question          Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  boite             Int       @default(1)
  prochaineEcheance DateTime?
  historique        String    @default("[]") @db.Text // JSON: { date: string, correct: boolean }[]
}

/// Corrigé officiel importé après la remise (M5) — vérité de référence.
model OfficialKey {
  id                String   @id @default(cuid())
  courseId          String   @unique
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reponsesImportees String   @db.Text // JSON: { question: number, reponse: string }[]
  ecartsDetectes    String   @default("[]") @db.Text // JSON
  importeLe         DateTime @default(now())
}

/// Historique des questions Q&A posées par l'étudiant.
model QaMessage {
  id             String     @id @default(cuid())
  courseId       String
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studyUnitId    String?
  studyUnit      StudyUnit? @relation(fields: [studyUnitId], references: [id], onDelete: SetNull)
  question       String     @db.Text
  reponse        String     @db.Text
  // source : cours | exterieur | mixte
  source         String
  // mode : cours | cours_web
  mode           String     @default("cours")
  sectionsCitees String     @default("[]") @db.Text // JSON: { id: string, titre: string }[]
  sourcesWeb     String     @default("[]") @db.Text // JSON: { title: string | null, url: string }[]
  createdAt      DateTime   @default(now())

  @@index([courseId, createdAt])
  @@index([studyUnitId, createdAt])
}

/// Journalisation de l'usage API Anthropic (dès M2).
model ApiUsageLog {
  id           String   @id @default(cuid())
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  phase        String   // ingestion | verification | qa
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
}
