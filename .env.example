# NaturoFiche — variables d'environnement (copier vers .env)

# Clé API Anthropic — STRICTEMENT côté serveur, jamais exposée au client.
ANTHROPIC_API_KEY=sk-ant-...

# Base SQLite locale (chemin relatif au dossier prisma/).
DATABASE_URL="file:./dev.db"

# Modèles Anthropic configurables (cf. cahier des charges §8).
# Ingestion = jugement nuancé → Opus ; vérification = contre-regard ; Q&A = léger.
INGEST_MODEL=claude-opus-4-8
VERIFY_MODEL=claude-sonnet-5
QA_MODEL=claude-haiku-4-5-20251001

# Mot de passe d'accès optionnel (l'app passe par un tunnel public).
# Laisser vide = app ouverte, sans authentification.
ACCESS_PASSWORD=
